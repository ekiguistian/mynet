# Operating system and editor files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Local environment and secrets
/.env*
!/.env.example
/secrets/
*.pem
*.key

# Composer dependencies
/vendor/

# CodeIgniter writable runtime data
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/queue/*
!/writable/queue/index.html
php_errors.log

# Tests, coverage and generated docs
/tests/coverage*
/phpunit
/builds/

# Front-end dependencies and generated assets
/node_modules/
/public/build/

# Local databases and dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
